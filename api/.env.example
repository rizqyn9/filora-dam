PORT=8080
DATABASE_URL=postgres://user:pass@localhost:5432/filora?sslmode=disable
ENVIRONMENT=development

# 32-byte hex key for AES-256-GCM (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Axiom (OpenTelemetry) — leave empty to disable tracing
AXIOM_TOKEN=
AXIOM_DATASET=filora
AXIOM_METRICS_DATASET=filora-metrics
AXIOM_ENDPOINT=api.axiom.co
